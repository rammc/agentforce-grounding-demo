# Eval-Harness Konfiguration
# Datei unter dem Namen .env im Repo-Root anlegen, NICHT committen.

# ----- Salesforce-Org -----
# My-Domain-URL (ohne trailing slash). Aus `sf org display --target-org aerolift-demo`.
SF_INSTANCE_URL=https://YOUR-DOMAIN.my.salesforce.com

# External Client App Credentials (siehe DEPLOY.md Schritt 6.5).
# Scopes: api, chatbot_api, sfap_api
SF_CLIENT_ID=your-eca-consumer-key
SF_CLIENT_SECRET=your-eca-consumer-secret

# ----- Agent IDs -----
# Aus Setup → Agent Builder → Agent Detail → API Name oder ID kopieren.
# Format z.B. 0XxQ0000000ABcDEAW.
AGENT_A_ID=0XxQ00000000000AAA
AGENT_B_ID=0XxQ00000000000AAB

# ----- LLM-Judge -----
# Anthropic API Key für Claude-Judge bei PARTIAL-Verdict.
# Mit --skip-judge auf dem CLI nicht erforderlich.
ANTHROPIC_API_KEY=sk-ant-...
